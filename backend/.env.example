# Copy to a real env (Render / local shell). Never commit secrets.

# Profiles: local (default, H2 console) | prod (Render)
# SPRING_PROFILES_ACTIVE=prod

# Neon example:
# DATABASE_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_USERNAME=neondb_owner
# DATABASE_PASSWORD=********
# DATABASE_DRIVER=org.postgresql.Driver

# JWT (min 32 characters) — required in prod / with Postgres
# JWT_SECRET=change-me-to-a-long-random-secret-key
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# JWT_COOKIE_SECURE=true

# CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://ton-app.vercel.app

# SEED_ENABLED=false

# Password reset links
# FRONTEND_BASE_URL=https://ton-app.vercel.app
# PASSWORD_RESET_TTL_MINUTES=60
# MAIL_FROM=noreply@ensem.jee
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

